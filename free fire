#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_ROOT="$(dirname "$DIR")"
cd "$APP_ROOT"

# Ensure PATH includes common locations for Mono
export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"

# Source shell profiles if they exist to get environment variables
if [ -f ~/.bash_profile ]; then
    source ~/.bash_profile 2>/dev/null
elif [ -f ~/.zshrc ]; then
    source ~/.zshrc 2>/dev/null
fi

# Check if Mono is installed
if ! command -v mono &> /dev/null; then
    echo "Error: Mono is required to run this application."
    
    # Check if we can install Mono via package installer
    if [ -f "mdk-latest.pkg" ]; then
        echo "Installing Mono from downloaded package..."
        sudo installer -pkg mdk-latest.pkg -target /
        rm mdk-latest.pkg
    else
        echo "Attempting to download and install Mono..."
        # Try to download and install Mono directly
        curl -O https://download.mono-project.com/archive/mdk-latest.pkg
        if [ -f "mdk-latest.pkg" ]; then
            sudo installer -pkg mdk-latest.pkg -target /
            rm mdk-latest.pkg
        else
            echo "Could not download Mono installer. Please install manually."
            echo "Download from: https://www.mono-project.com/download/stable/"
            osascript -e 'display dialog "Mono is required to run this application. Please install Mono from https://www.mono-project.com/download/stable/" with icon stop' 2>/dev/null || echo "Display dialog failed, showing in terminal"
