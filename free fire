#!/bin/bash

# Free Fire Cheat UI All-in-One Installer for macOS
# This script contains all necessary components to compile and install the cheat UI on macOS

echo "Free Fire Pro Max Plus Ultra All-in-One Installer"
echo "================================================="
echo ""
echo "NOTE: If you encounter compilation errors, you may need to:"
echo "  1. Restart your terminal session after the first run"
echo "  2. Manually install Mono with: brew install mono"
echo "  3. Ensure Xcode Command Line Tools are installed: xcode-select --install"
echo ""

# Check if running on macOS
if [[ "$OSTYPE" != "darwin"* ]]; then
    echo "Error: This installer is only for macOS."
    exit 1
fi

echo "Checking for required dependencies..."

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    
    # Add Homebrew to PATH immediately after installation
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
        # Apple Silicon Mac
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
        # Intel Mac
        eval "$(/usr/local/bin/brew shellenv)"
    fi
else
    echo "Homebrew already installed."
    
    # Ensure Homebrew is in PATH
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
        # Apple Silicon Mac
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
        # Intel Mac
        eval "$(/usr/local/bin/brew shellenv)"
    fi
fi

# Install Mono (required to compile and run C# applications on macOS)
if ! command -v mono &> /dev/null; then
    echo "Installing Mono..."
    if command -v brew &> /dev/null; then
        brew install mono
    else
        echo "Homebrew installation failed. Attempting direct Mono installation..."
        # Direct download and install of Mono
        curl -O https://download.mono-project.com/archive/mdk-latest.pkg
        sudo installer -pkg mdk-latest.pkg -target /
        rm mdk-latest.pkg
        
        # Add Mono to PATH
        export PATH="/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"
        export PKG_CONFIG_PATH="/Library/Frameworks/Mono.framework/Versions/Current/lib/pkgconfig"
        
        # Add to profile files for persistence
        echo 'export PATH="/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"' >> ~/.bash_profile 2>/dev/null || true
        echo 'export PKG_CONFIG_PATH="/Library/Frameworks/Mono.framework/Versions/Current/lib/pkgconfig"' >> ~/.bash_profile 2>/dev/null || true
        echo 'export PATH="/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"' >> ~/.zshrc 2>/dev/null || true
        echo 'export PKG_CONFIG_PATH="/Library/Frameworks/Mono.framework/Versions/Current/lib/pkgconfig"' >> ~/.zshrc 2>/dev/null || true
    fi
    
    # Update PATH to include Mono binaries
    export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"
else
    echo "Mono already installed."
    # Ensure PATH includes Mono
    export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Mono.framework/Versions/Current/bin:$PATH"
fi

# Install NuGet if not present (for package management)
if ! command -v nuget &> /dev/null; then
    echo "Installing NuGet..."
    if command -v brew &> /dev/null; then
        brew install nuget
    else
        echo "Cannot install NuGet without Homebrew. Skipping..."
    fi
else
    echo "NuGet already installed."
fi

echo ""
echo "Creating project structure..."
APP_NAME="FreeFireCheatUI"
APP_DIR="$HOME/Applications/$APP_NAME"
mkdir -p "$APP_DIR"

echo "Creating C# source files..."

# Create CheatForm.cs
cat > "$APP_DIR/CheatForm.cs" << 'EOF'
using System;
using System.Collections.Generic;
using System.Drawing;
using System.Threading;
using System.Windows.Forms;

namespace FreeFireCheatUI
{
    public partial class CheatForm : Form
    {
        private Panel sidePanel;
        private Panel contentPanel;
        private Dictionary<string, Panel> tabPanels;
        private Dictionary<string, Button> tabButtons;

        public CheatForm()
        {
            InitializeComponent();
        }

        private void InitializeComponent()
        {
            // Form setup
            this.Text = "Free Fire Pro Max Plus Ultra";
            this.Size = new Size(800, 500);
            this.BackColor = Color.FromArgb(30, 30, 30);
            this.ForeColor = Color.White;
            this.FormBorderStyle = FormBorderStyle.FixedSingle;
            this.StartPosition = FormStartPosition.CenterScreen;

            // Create side panel for tabs
            sidePanel = new Panel
            {
                Size = new Size(150, this.ClientSize.Height),
                Location = new Point(0, 0),
                BackColor = Color.FromArgb(25, 25, 25)
            };
            this.Controls.Add(sidePanel);

            // Create content panel
            contentPanel = new Panel
            {
                Size = new Size(this.ClientSize.Width - 150, this.ClientSize.Height),
                Location = new Point(150, 0),
                BackColor = Color.FromArgb(40, 40, 40)
            };
            this.Controls.Add(contentPanel);

            // Initialize tab system
            InitializeTabs();
        }

        private void InitializeTabs()
        {
            tabPanels = new Dictionary<string, Panel>();
            tabButtons = new Dictionary<string, Button>();

            string[] tabNames = { "ESP", "Aimbot", "Misc", "Settings" };

            for (int i = 0; i < tabNames.Length; i++)
            {
                // Create tab button
                Button tabButton = new Button
                {
                    Text = tabNames[i],
                    Size = new Size(150, 50),
                    Location = new Point(0, i * 50),
                    BackColor = Color.FromArgb(50, 50, 50),
                    FlatStyle = FlatStyle.Flat,
                    ForeColor = Color.White,
                    TextAlign = ContentAlignment.MiddleLeft
                };
                tabButton.FlatAppearance.BorderSize = 0;
                tabButton.Click += TabButton_Click;
                sidePanel.Controls.Add(tabButton);
                tabButtons[tabNames[i]] = tabButton;

                // Create tab panel
                Panel tabPanel = new Panel
                {
                    Size = contentPanel.Size,
                    Location = new Point(0, 0),
                    BackColor = Color.FromArgb(40, 40, 40),
                    Visible = false
                };
                contentPanel.Controls.Add(tabPanel);
                tabPanels[tabNames[i]] = tabPanel;
            }

            // Create content for each tab
            CreateESPTab();
            CreateAimbotTab();
            CreateMiscTab();
            CreateSettingsTab();

            // Show first tab by default
            SwitchTab("ESP");
        }

        private void TabButton_Click(object sender, EventArgs e)
        {
            Button clickedButton = (Button)sender;
            foreach (var kvp in tabButtons)
            {
                if (kvp.Value == clickedButton)
                {
                    SwitchTab(kvp.Key);
                    break;
                }
            }
        }

        private void SwitchTab(string tabName)
        {
            // Hide all panels and reset button colors
            foreach (var panel in tabPanels.Values)
                panel.Visible = false;
            
            foreach (var button in tabButtons.Values)
                button.BackColor = Color.FromArgb(50, 50, 50);

            // Show selected panel and highlight button
            tabPanels[tabName].Visible = true;
            tabButtons[tabName].BackColor = Color.DodgerBlue;
        }

        private void CreateESPTab()
        {
            Panel panel = tabPanels["ESP"];
            int yPos = 20;

            AddSectionTitle(panel, "Player ESP", ref yPos);
            AddToggle(panel, "Box ESP", ref yPos);
            AddToggle(panel, "Line ESP", ref yPos);
            AddToggle(panel, "Name ESP", ref yPos);
            AddToggle(panel, "Distance ESP", ref yPos);
            AddToggle(panel, "Health ESP", ref yPos);
            AddToggle(panel, "Skeleton ESP", ref yPos);
            
            AddSectionTitle(panel, "Item ESP", ref yPos);
            AddToggle(panel, "Weapon ESP", ref yPos);
            AddToggle(panel, "Ammo ESP", ref yPos);
            AddToggle(panel, "Medkit ESP", ref yPos);
            AddToggle(panel, "Helmet ESP", ref yPos);
            AddToggle(panel, "Vest ESP", ref yPos);
        }

        private void CreateAimbotTab()
        {
            Panel panel = tabPanels["Aimbot"];
            int yPos = 20;

            AddSectionTitle(panel, "Aim Settings", ref yPos);
            AddToggle(panel, "Enable Aimbot", ref yPos);
            AddComboBox(panel, "Aim Key", new[] { "Right Mouse", "Left Mouse", "Shift", "Ctrl" }, ref yPos);
            AddSlider(panel, "Smoothness", 1, 20, 10, ref yPos);
            AddComboBox(panel, "Aim Position", new[] { "Head", "Body", "Legs" }, ref yPos);
            AddToggle(panel, "Auto Fire", ref yPos);
            AddToggle(panel, "Auto Wallbang", ref yPos);
            
            AddSectionTitle(panel, "FOV Settings", ref yPos);
            AddSlider(panel, "FOV Size", 10, 500, 100, ref yPos);
            AddToggle(panel, "Draw FOV Circle", ref yPos);
            
            AddSectionTitle(panel, "Target Priority", ref yPos);
            AddComboBox(panel, "Priority Mode", new[] { "Closest", "Lowest HP", "Furthest" }, ref yPos);
        }

        private void CreateMiscTab()
        {
            Panel panel = tabPanels["Misc"];
            int yPos = 20;

            AddSectionTitle(panel, "Movement Hacks", ref yPos);
            AddToggle(panel, "Speed Hack", ref yPos);
            AddSlider(panel, "Speed Value", 1, 5, 2, ref yPos);
            AddToggle(panel, "No Recoil", ref yPos);
            AddToggle(panel, "No Spread", ref yPos);
            
            AddSectionTitle(panel, "Visual Hacks", ref yPos);
            AddToggle(panel, "FPS Boost", ref yPos);
            AddToggle(panel, "No Fog", ref yPos);
            AddToggle(panel, "Night Mode", ref yPos);
            AddToggle(panel, "Crosshair", ref yPos);
            
            AddSectionTitle(panel, "Gameplay Hacks", ref yPos);
            AddToggle(panel, "Instant Medkit", ref yPos);
            AddToggle(panel, "No Reload", ref yPos);
            AddToggle(panel, "Infinite Ammo", ref yPos);
            AddToggle(panel, "Rapid Fire", ref yPos);
        }

        private void CreateSettingsTab()
        {
            Panel panel = tabPanels["Settings"];
            int yPos = 20;

            AddSectionTitle(panel, "General Settings", ref yPos);
            AddToggle(panel, "Start With Windows", ref yPos);
            AddToggle(panel, "Minimize To Tray", ref yPos);
            AddToggle(panel, "Anti-Cheat Bypass", ref yPos);
            
            AddSectionTitle(panel, "Keybinds", ref yPos);
            AddKeybind(panel, "Menu Key", "Insert", ref yPos);
            AddKeybind(panel, "Panic Key", "Delete", ref yPos);
            
            AddSectionTitle(panel, "Config", ref yPos);
            AddButton(panel, "Save Config", ref yPos);
            AddButton(panel, "Load Config", ref yPos);
            AddButton(panel, "Reset Config", ref yPos);
            
            AddSectionTitle(panel, "About", ref yPos);
            Label aboutLabel = new Label
            {
                Text = "Free Fire Pro Max Plus Ultra v2.0\nFor Educational Purposes Only",
                Location = new Point(20, yPos),
                Size = new Size(300, 40),
                ForeColor = Color.Gray
            };
            panel.Controls.Add(aboutLabel);
        }

        private void AddSectionTitle(Panel panel, string title, ref int yPos)
        {
            Label label = new Label
            {
                Text = title,
                Location = new Point(10, yPos),
                Size = new Size(200, 25),
                ForeColor = Color.DodgerBlue,
                Font = new Font(this.Font, FontStyle.Bold)
            };
            panel.Controls.Add(label);
            yPos += 30;
        }

        private void AddToggle(Panel panel, string text, ref int yPos)
        {
            CheckBox checkBox = new CheckBox
            {
                Text = text,
                Location = new Point(20, yPos),
                Size = new Size(200, 25),
                ForeColor = Color.White,
                Checked = false
            };
            panel.Controls.Add(checkBox);
            yPos += 30;
        }

        private void AddSlider(Panel panel, string text, int min, int max, int defaultValue, ref int yPos)
        {
            Label label = new Label
            {
                Text = $"{text}: {defaultValue}",
                Location = new Point(20, yPos),
                Size = new Size(200, 25),
                ForeColor = Color.White
            };
            
            TrackBar trackBar = new TrackBar
            {
                Location = new Point(20, yPos + 25),
                Size = new Size(200, 45),
                Minimum = min,
                Maximum = max,
                Value = defaultValue
            };
            
            trackBar.Scroll += (s, e) => {
                label.Text = $"{text}: {trackBar.Value}";
            };
            
            panel.Controls.Add(label);
            panel.Controls.Add(trackBar);
            yPos += 80;
        }

        private void AddComboBox(Panel panel, string text, string[] items, ref int yPos)
        {
            Label label = new Label
            {
                Text = text,
                Location = new Point(20, yPos),
                Size = new Size(150, 25),
                ForeColor = Color.White
            };
            
            ComboBox comboBox = new ComboBox
            {
                Location = new Point(20, yPos + 25),
                Size = new Size(150, 25),
                DropDownStyle = ComboBoxStyle.DropDownList
            };
            comboBox.Items.AddRange(items);
            if (items.Length > 0) comboBox.SelectedIndex = 0;
            
            panel.Controls.Add(label);
            panel.Controls.Add(comboBox);
            yPos += 60;
        }

        private void AddKeybind(Panel panel, string text, string defaultKey, ref int yPos)
        {
            Label label = new Label
            {
                Text = text,
                Location = new Point(20, yPos),
                Size = new Size(150, 25),
                ForeColor = Color.White
            };
            
            TextBox textBox = new TextBox
            {
                Location = new Point(20, yPos + 25),
                Size = new Size(100, 25),
                Text = defaultKey,
                ReadOnly = true
            };
            
            textBox.Click += (s, e) => {
                MessageBox.Show("Press any key to bind...");
                // In a real app, you would capture the key here
            };
            
            panel.Controls.Add(label);
            panel.Controls.Add(textBox);
            yPos += 60;
        }

        private void AddButton(Panel panel, string text, ref int yPos)
        {
            Button button = new Button
            {
                Text = text,
                Location = new Point(20, yPos),
                Size = new Size(150, 30),
                BackColor = Color.FromArgb(60, 60, 60),
                ForeColor = Color.White,
                FlatStyle = FlatStyle.Flat
            };
            button.FlatAppearance.BorderSize = 1;
            panel.Controls.Add(button);
            yPos += 40;
        }

        [STAThread]
        public static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new CheatForm());
        }
    }
}
