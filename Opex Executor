#!/bin/bash
set -e

# ─────────────────────────────────────────────
#  Opex Hub – One‑script builder & launcher
#  Creates the full C++ (Qt) project, builds,
#  and runs the app automatically.
# ─────────────────────────────────────────────

PROJECT_DIR="OpexExecutor"
APP_NAME="Opex Executoe"

# Check/install Qt
if ! command -v qmake &>/dev/null; then
    echo "Qt not found. Installing with Homebrew..."
    if ! command -v brew &>/dev/null; then
        echo "Homebrew required. Install from https://brew.sh"
        exit 1
    fi
    brew install qt
    echo "Qt installed. Please re-run this script."
    exit 0
fi

# Create project directory
mkdir -p "$PROJECT_DIR"
cd "$PROJECT_DIR"

# -------------------- OpexHub.pro --------------------
cat > OpexExecutor.pro << 'PROEOF'
QT       += core gui widgets
TARGET    = OpexHub
TEMPLATE  = app
SOURCES  += main.cpp \
            MainWindow.cpp
HEADERS  += MainWindow.h
PROEOF

# -------------------- main.cpp --------------------
cat > main.cpp << 'CPPEOF'
#include <QApplication>
#include "MainWindow.h"

int main(int argc, char *argv[]) {
    QApplication app(argc, argv);
    MainWindow window;
    window.setWindowTitle("Opex Hub");
    window.resize(600, 500);
    window.show();
    return app.exec();
}
CPPEOF

# -------------------- MainWindow.h --------------------
cat > MainWindow.h << 'HEADEOF'
#ifndef MAINWINDOW_H
#define MAINWINDOW_H

#include <QMainWindow>
#include <QTextEdit>
#include <QPushButton>

class MainWindow : public QMainWindow {
    Q_OBJECT

public:
    explicit MainWindow(QWidget *parent = nullptr);

private slots:
    void onInject();
    void onExecute();
    void onClear();

private:
    QTextEdit *scriptEditor;
    QPushButton *btnInject;
    QPushButton *btnExecute;
    QPushButton *btnClear;
};

#endif // MAINWINDOW_H
HEADEOF

# -------------------- MainWindow.cpp --------------------
cat > MainWindow.cpp << 'CPPEOF'
#include "MainWindow.h"
#include <QVBoxLayout>
#include <QHBoxLayout>
#include <QLabel>
#include <QFont>
#include <QDebug>

MainWindow::MainWindow(QWidget *parent)
    : QMainWindow(parent)
{
    // Central widget and layout
    QWidget *central = new QWidget(this);
    setCentralWidget(central);

    // Blue background
    central->setStyleSheet("background-color: #1E90FF;");

    QVBoxLayout *mainLayout = new QVBoxLayout(central);
    mainLayout->setSpacing(12);

    // Title
    QLabel *title = new QLabel("Opex Hub", this);
    title->setFont(QFont("Arial", 24, QFont::Bold));
    title->setStyleSheet("color: white;");
    title->setAlignment(Qt::AlignCenter);
    mainLayout->addWidget(title);

    // Script editor
    scriptEditor = new QTextEdit(this);
    scriptEditor->setPlaceholderText("Paste your Lua script here...");
    scriptEditor->setFont(QFont("Menlo", 12));
    scriptEditor->setStyleSheet(
        "background-color: rgba(0, 0, 0, 180);"
        "color: white;"
        "border: 1px solid white;"
        "border-radius: 8px;"
        "padding: 8px;"
    );
    mainLayout->addWidget(scriptEditor);

    // Button row
    QHBoxLayout *btnLayout = new QHBoxLayout();
    btnLayout->setSpacing(20);

    btnInject = new QPushButton("Inject", this);
    btnInject->setStyleSheet(
        "QPushButton { background-color: orange; color: white; font-weight: bold; "
        "border-radius: 6px; padding: 8px 16px; }"
        "QPushButton:hover { background-color: darkorange; }"
    );
    btnLayout->addWidget(btnInject);

    btnExecute = new QPushButton("Execute", this);
    btnExecute->setStyleSheet(
        "QPushButton { background-color: green; color: white; font-weight: bold; "
        "border-radius: 6px; padding: 8px 16px; }"
        "QPushButton:hover { background-color: darkgreen; }"
    );
    btnLayout->addWidget(btnExecute);

    btnClear = new QPushButton("Clear", this);
    btnClear->setStyleSheet(
        "QPushButton { background-color: red; color: white; font-weight: bold; "
        "border-radius: 6px; padding: 8px 16px; }"
        "QPushButton:hover { background-color: darkred; }"
    );
    btnLayout->addWidget(btnClear);

    mainLayout->addLayout(btnLayout);

    // Connect buttons
    connect(btnInject, &QPushButton::clicked, this, &MainWindow::onInject);
    connect(btnExecute, &QPushButton::clicked, this, &MainWindow::onExecute);
    connect(btnClear, &QPushButton::clicked, this, &MainWindow::onClear);
}

// ─────────────────────────────────────────────
//  Stub functions – replace with real injection / execution code
// ─────────────────────────────────────────────
void MainWindow::onInject() {
    qDebug() << "Inject button clicked.";
    // TODO: attach to Roblox process, load dylib, etc.
}

void MainWindow::onExecute() {
    QString code = scriptEditor->toPlainText().trimmed();
    if (!code.isEmpty()) {
        qDebug() << "Executing Lua:\n" << code;
        // TODO: send code to injected module
    }
}

void MainWindow::onClear() {
    scriptEditor->clear();
}
CPPEOF

# ─── Build ─────────────────────────────────
echo "Building Opex Hub..."
qmake OpexHub.pro
make

# ─── Launch ────────────────────────────────
echo "Launching Opex Hub..."
open OpexHub.app
