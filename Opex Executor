#!/bin/bash
# Opex Executor – macOS solid-blue UI (no photo)
# Requires Xcode Command Line Tools (clang++ with Cocoa)
# Provide a valid libopexapi.dylib for real injection/execution.

set -e
TMPDIR=$(mktemp -d /tmp/opex_XXXX)
cd "$TMPDIR"

cat > opex.mm << 'EOF_CODE'
#import <Cocoa/Cocoa.h>
#import <dlfcn.h>

// -------------------------------------------------------------------
//  Dynamic library loading for Api.inject() / Api.execute(script)
// -------------------------------------------------------------------
typedef void (*InjectFunc)();
typedef void (*ExecuteFunc)(const char*);

static InjectFunc  pInject  = nullptr;
static ExecuteFunc pExecute = nullptr;
static void*       apiHandle = nullptr;

static bool loadApiLibrary() {
    if (pInject && pExecute) return true;
    const char* paths[] = {
        "./libopexapi.dylib",
        "@executable_path/libopexapi.dylib",
        "/usr/local/lib/libopexapi.dylib",
        nullptr
    };
    for (const char** path = paths; *path; ++path) {
        apiHandle = dlopen(*path, RTLD_LAZY);
        if (apiHandle) break;
    }
    if (!apiHandle) return false;
    pInject  = (InjectFunc) dlsym(apiHandle, "Api_Inject");
    pExecute = (ExecuteFunc)dlsym(apiHandle, "Api_Execute");
    if (!pInject || !pExecute) {
        dlclose(apiHandle);
        apiHandle = nullptr;
        return false;
    }
    return true;
}

class Api {
public:
    static bool inject() {
        if (!loadApiLibrary()) return false;
        pInject();
        return true;
    }
    static bool execute(const char* script) {
        if (!loadApiLibrary()) return false;
        pExecute(script);
        return true;
    }
};

// -------------------------------------------------------------------
//  App Delegate
// -------------------------------------------------------------------
@interface AppDelegate : NSObject <NSApplicationDelegate, NSTextViewDelegate>
@property (strong) NSTextView *scriptView;
@end

@implementation AppDelegate

- (void)buildUI {
    NSWindow *window = [[NSWindow alloc] initWithContentRect:NSMakeRect(0,0,800,520)
                                                   styleMask:(NSWindowStyleMaskTitled |
                                                              NSWindowStyleMaskClosable |
                                                              NSWindowStyleMaskMiniaturizable)
                                                     backing:NSBackingStoreBuffered
                                                       defer:NO];
    [window setTitle:@"Opex Executor"];
    // Solid blue background
    [window setBackgroundColor:[NSColor blueColor]];

    NSView *contentView = [window contentView];

    // Title label (white, centered)
    NSTextField *titleLabel = [[NSTextField alloc] initWithFrame:NSMakeRect(0, 470, 800, 40)];
    [titleLabel setStringValue:@"Opex Executor"];
    [titleLabel setFont:[NSFont boldSystemFontOfSize:24]];
    [titleLabel setTextColor:[NSColor whiteColor]];
    [titleLabel setBackgroundColor:[NSColor clearColor]];
    [titleLabel setBezeled:NO];
    [titleLabel setEditable:NO];
    [titleLabel setAlignment:NSTextAlignmentCenter];
    [contentView addSubview:titleLabel];

    // Scroll view for script
    NSScrollView *scrollView = [[NSScrollView alloc] initWithFrame:NSMakeRect(20, 60, 760, 390)];
    [scrollView setHasVerticalScroller:YES];
    [scrollView setAutoresizingMask:(NSViewWidthSizable|NSViewHeightSizable)];
    [scrollView setBorderType:NSBezelBorder];

    NSTextView *textView = [[NSTextView alloc] initWithFrame:NSMakeRect(0, 0, 760, 390)];
    [textView setFont:[NSFont userFixedPitchFontOfSize:13]];
    [textView setBackgroundColor:[NSColor colorWithCalibratedRed:0.94 green:0.97 blue:1.0 alpha:1.0]];
    [textView setTextColor:[NSColor blackColor]];
    self.scriptView = textView;

    [scrollView setDocumentView:textView];
    [contentView addSubview:scrollView];

    // Buttons
    NSButton *injectBtn = [[NSButton alloc] initWithFrame:NSMakeRect(20, 15, 100, 32)];
    [injectBtn setTitle:@"Inject"];
    [injectBtn setBezelStyle:NSBezelStyleRounded];
    [injectBtn setTarget:self];
    [injectBtn setAction:@selector(injectAction:)];
    [contentView addSubview:injectBtn];

    NSButton *executeBtn = [[NSButton alloc] initWithFrame:NSMakeRect(140, 15, 100, 32)];
    [executeBtn setTitle:@"Execute"];
    [executeBtn setBezelStyle:NSBezelStyleRounded];
    [executeBtn setTarget:self];
    [executeBtn setAction:@selector(executeAction:)];
    [contentView addSubview:executeBtn];

    NSButton *clearBtn = [[NSButton alloc] initWithFrame:NSMakeRect(260, 15, 100, 32)];
    [clearBtn setTitle:@"Clear"];
    [clearBtn setBezelStyle:NSBezelStyleRounded];
    [clearBtn setTarget:self];
    [clearBtn setAction:@selector(clearAction:)];
    [contentView addSubview:clearBtn];

    [window makeKeyAndOrderFront:nil];
}

- (void)injectAction:(id)sender {
    if (Api::inject()) {
        NSAlert *alert = [[NSAlert alloc] init];
        [alert setMessageText:@"Injection Successful"];
        [alert setInformativeText:@"Executor injected into Roblox."];
        [alert runModal];
    } else {
        NSAlert *alert = [[NSAlert alloc] init];
        [alert setMessageText:@"Injection Failed"];
        [alert setInformativeText:@"Could not load libopexapi.dylib.\n"
                               "Place a valid library next to this app and try again."];
        [alert runModal];
    }
}

- (void)executeAction:(id)sender {
    NSString *code = [self.scriptView string];
    if ([code length] == 0) {
        NSAlert *alert = [[NSAlert alloc] init];
        [alert setMessageText:@"No Script"];
        [alert setInformativeText:@"Please enter a script to execute."];
        [alert runModal];
        return;
    }
    const char* cScript = [code UTF8String];
    if (Api::execute(cScript)) {
        NSAlert *alert = [[NSAlert alloc] init];
        [alert setMessageText:@"Execution Successful"];
        [alert setInformativeText:[NSString stringWithFormat:@"Executed script:\n%@", code]];
        [alert runModal];
    } else {
        NSAlert *alert = [[NSAlert alloc] init];
        [alert setMessageText:@"Execution Failed"];
        [alert setInformativeText:@"Injection library not loaded.\n"
                               "Make sure libopexapi.dylib is present and you have injected first."];
        [alert runModal];
    }
}

- (void)clearAction:(id)sender {
    [self.scriptView setString:@""];
}

- (void)applicationDidFinishLaunching:(NSNotification *)aNotification {
    [self buildUI];
}

- (BOOL)applicationShouldTerminateAfterLastWindowClosed:(NSApplication *)sender {
    return YES;
}

- (void)dealloc {
    if (apiHandle) dlclose(apiHandle);
}

@end

int main() {
    @autoreleasepool {
        NSApplication *app = [NSApplication sharedApplication];
        AppDelegate *delegate = [[AppDelegate alloc] init];
        [app setDelegate:delegate];
        [app run];
    }
    return 0;
}
EOF_CODE

# Compile and run
clang++ -framework Cocoa -o opex_executor opex.mm
./opex_executor

# Cleanup after exit
cd /
rm -rf "$TMPDIR"
