using System;
using System.Drawing;
using System.Windows.Forms;

namespace OpexHub
{
    public partial class MainForm : Form
    {
        private Panel topBarPanel;
        private Label lblTitle;
        private RichTextBox scriptTextBox;
        private Button btnExecute;
        private Button btnInject;
        private Button btnClear;
        private Button btnClose;

        public MainForm()
        {
            InitializeComponent();
            SetupModernUI();
        }

        private void SetupModernUI()
        {
            // Configure the main window (Borderless modern style)
            this.Text = "Opex Hub";
            this.Size = new Size(650, 440);
            this.StartPosition = FormStartPosition.CenterScreen;
            this.FormBorderStyle = FormBorderStyle.None;
            this.BackColor = Color.FromArgb(18, 18, 24); // Deep dark blue-gray background

            // Custom Modern Top Bar
            topBarPanel = new Panel();
            topBarPanel.Size = new Size(650, 35);
            topBarPanel.Location = new Point(0, 0);
            topBarPanel.BackColor = Color.FromArgb(24, 24, 32);
            topBarPanel.MouseDown += TopBarPanel_MouseDown;
            this.Controls.Add(topBarPanel);

            // Title Label ("Opex Hub")
            lblTitle = new Label();
            lblTitle.Text = "Opex Hub";
            lblTitle.Font = new Font("Segoe UI", 10.5F, FontStyle.Bold);
            lblTitle.ForeColor = Color.FromArgb(0, 122, 255); // Vibrant modern blue
            lblTitle.Location = new Point(12, 7);
            lblTitle.AutoSize = true;
            topBarPanel.Controls.Add(lblTitle);

            // Close Button for custom borderless window
            btnClose = new Button();
            btnClose.Text = "âœ•";
            btnClose.Size = new Size(45, 35);
            btnClose.Location = new Point(605, 0);
            btnClose.FlatStyle = FlatStyle.Flat;
            btnClose.FlatAppearance.BorderSize = 0;
            btnClose.ForeColor = Color.DarkGray;
            btnClose.BackColor = Color.Transparent;
            btnClose.Cursor = Cursors.Hand;
            btnClose.Click += (s, e) => Application.Exit();
            btnClose.MouseEnter += (s, e) => { btnClose.BackColor = Color.FromArgb(200, 40, 40); btnClose.ForeColor = Color.White; };
            btnClose.MouseLeave += (s, e) => { btnClose.BackColor = Color.Transparent; btnClose.ForeColor = Color.DarkGray; };
            topBarPanel.Controls.Add(btnClose);

            // RichTextBox for script input
            scriptTextBox = new RichTextBox();
            scriptTextBox.Location = new Point(15, 50);
            scriptTextBox.Size = new Size(620, 310);
            scriptTextBox.BackColor = Color.FromArgb(26, 26, 36);
            scriptTextBox.ForeColor = Color.FromArgb(220, 220, 230);
            scriptTextBox.Font = new Font("Consolas", 10F, FontStyle.Regular);
            scriptTextBox.BorderStyle = BorderStyle.None;
            scriptTextBox.Text = "-- Welcome to Opex Hub\n-- Paste your script here...\n";
            this.Controls.Add(scriptTextBox);

            // Execute Button (Accent Blue)
            btnExecute = new Button();
            btnExecute.Text = "Execute";
            btnExecute.Location = new Point(15, 380);
            btnExecute.Size = new Size(110, 38);
            btnExecute.BackColor = Color.FromArgb(0, 122, 255);
            btnExecute.ForeColor = Color.White;
            btnExecute.Font = new Font("Segoe UI", 9.5F, FontStyle.Bold);
            btnExecute.FlatStyle = FlatStyle.Flat;
            btnExecute.FlatAppearance.BorderSize = 0;
            btnExecute.Cursor = Cursors.Hand;
            btnExecute.Click += BtnExecute_Click;
            this.Controls.Add(btnExecute);

            // Inject Button
            btnInject = new Button();
            btnInject.Text = "Inject";
            btnInject.Location = new Point(135, 380);
            btnInject.Size = new Size(110, 38);
            btnInject.BackColor = Color.FromArgb(35, 35, 48);
            btnInject.ForeColor = Color.FromArgb(0, 122, 255);
            btnInject.Font = new Font("Segoe UI", 9.5F, FontStyle.Bold);
            btnInject.FlatStyle = FlatStyle.Flat;
            btnInject.FlatAppearance.BorderColor = Color.FromArgb(0, 122, 255);
            btnInject.Cursor = Cursors.Hand;
            btnInject.Click += BtnInject_Click;
            this.Controls.Add(btnInject);

            // Clear Button
            btnClear = new Button();
            btnClear.Text = "Clear";
            btnClear.Location = new Point(525, 380);
            btnClear.Size = new Size(110, 38);
            btnClear.BackColor = Color.FromArgb(35, 35, 48);
            btnClear.ForeColor = Color.FromArgb(200, 200, 200);
            btnClear.Font = new Font("Segoe UI", 9.5F, FontStyle.Regular);
            btnClear.FlatStyle = FlatStyle.Flat;
            btnClear.FlatAppearance.BorderSize = 0;
            btnClear.Cursor = Cursors.Hand;
            btnClear.Click += BtnClear_Click;
            this.Controls.Add(btnClear);
        }

        // Allow dragging the borderless window by clicking the top bar
        [System.Runtime.InteropServices.DllImport("user32.DLL", EntryPoint = "ReleaseCapture")]
        private extern static void ReleaseCapture();
        [System.Runtime.InteropServices.DllImport("user32.DLL", EntryPoint = "SendMessage")]
        private extern static void SendMessage(IntPtr hWnd, int wMsg, int wParam, int lParam);

        private void TopBarPanel_MouseDown(object sender, MouseEventArgs e)
        {
            if (e.Button == MouseButtons.Left)
            {
                ReleaseCapture();
                SendMessage(Handle, 0xA1, 0x2, 0);
            }
        }

        // Button Event Handlers
        private void BtnExecute_Click(object sender, EventArgs e)
        {
            MessageBox.Show("Executing script in Opex Hub...", "Opex Hub", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnInject_Click(object sender, EventArgs e)
        {
            MessageBox.Show("Injecting...", "Opex Hub", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnClear_Click(object sender, EventArgs e)
        {
            scriptTextBox.Clear();
        }

        [STAThread]
        public static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }
}
