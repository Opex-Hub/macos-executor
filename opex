// macos_executor.cpp
// Compile: clang++ -std=c++17 -arch arm64 -o executor macos_executor.cpp -framework CoreFoundation -ldl
// Note: Requires elevated privileges / disabled SIP to perform Mach task injection.

#include <mach/mach.h>
#include <mach/mach_vm.h>
#include <mach-o/dyld_images.h>
#include <sys/ptrace.h>
#include <dlfcn.h>
