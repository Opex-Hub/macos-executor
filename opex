func solidView(_ color: NSColor, _ radius: CGFloat = 0) -> NSView {
    let v = NSView()
    v.wantsLayer = true
    v.layer?.backgroundColor = color.cgColor
    v.layer?.cornerRadius = radius
    return v
}

final class PillButton: NSButton {
    private var baseColor: NSColor
    private var hoverColor: NSColor
    private var tracking: NSTrackingArea?

    init(title: String, base: NSColor, textColor: NSColor, target: AnyObject?, action: Selector, tooltip: String) {
        baseColor = base
        hoverColor = base.blended(withFraction: 0.20, of: .white) ?? base
        super.init(frame: .zero)
        isBordered = false
        setButtonType(.momentaryChange)
        wantsLayer = true
        attributedTitle = NSAttributedString(string: title, attributes: [
            .font: NSFont.systemFont(ofSize: 12.5, weight: .semibold),
            .foregroundColor: textColor
        ])
        self.target = target
        self.action = action
        toolTip = tooltip
    }
    required init?(coder: NSCoder) { fatalError("unsupported") }
    override func layout() {
        super.layout()
        wantsLayer = true
        layer?.cornerRadius = 6
        layer?.backgroundColor = baseColor.cgColor
    }
    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let t = tracking { removeTrackingArea(t) }
        let t = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeInKeyWindow], owner: self, userInfo: nil)
        addTrackingArea(t)
        tracking = t
    }
    override func mouseEntered(with event: NSEvent) { layer?.backgroundColor = hoverColor.cgColor }
    override func mouseExited(with event: NSEvent)  { layer?.backgroundColor = baseColor.cgColor }
    override var intrinsicContentSize: NSSize {
        let s = attributedTitle.size()
        return NSSize(width: s.width + 22, height: 26)
    }
}

final class TextButton: NSButton {
    private var active = false
    private let normalColor: NSColor
    private let activeColor: NSColor
    private let titleText: String

    init(_ title: String, normal: NSColor, active: NSColor, target: AnyObject?, action: Selector) {
        normalColor = normal
        activeColor = active
        titleText = title
        super.init(frame: .zero)
        isBordered = false
        setButtonType(.momentaryChange)
        self.target = target
        self.action = action
        render()
    }
    required init?(coder: NSCoder) { fatalError("unsupported") }
    func setActive(_ a: Bool) { active = a; render() }
    func setGlyph(_ g: String) {
        attributedTitle = NSAttributedString(string: g, attributes: [
            .font: NSFont.systemFont(ofSize: 13, weight: .medium),
            .foregroundColor: Theme.dim
        ])
    }
    private func render() {
        attributedTitle = NSAttributedString(string: titleText, attributes: [
            .font: NSFont.systemFont(ofSize: 11, weight: active ? .bold : .medium),
            .foregroundColor: active ? activeColor : normalColor,
            .kern: NSNumber(value: 1.2)
        ])
    }
    override var intrinsicContentSize: NSSize {
        let s = attributedTitle.size()
        return NSSize(width: s.width + 14, height: 20)
    }
}

final class GutterView: NSView {
    weak var textView: NSTextView?
    private var observing = false

    init(textView: NSTextView) {
        self.textView = textView
        super.init(frame: NSRect(x: 0, y: 0, width: 44, height: 10))
        textView.postsFrameChangedNotifications = true
        let nc = NotificationCenter.default
        nc.addObserver(self, selector: #selector(refresh),
                       name: NSText.didChangeNotification, object: textView)
        nc.addObserver(self, selector: #selector(refresh),
                       name: NSView.frameDidChangeNotification, object: textView)
    }
    required init?(coder: NSCoder) { fatalError("unsupported") }

    @objc func refresh() { needsDisplay = true }

    override var isFlipped: Bool { true }

    override func viewDidMoveToWindow() {
        super.viewDidMoveToWindow()
        guard !observing, window != nil,
              let clip = textView?.enclosingScrollView?.contentView else { return }
        clip.postsBoundsChangedNotifications = true
        NotificationCenter.default.addObserver(self, selector: #selector(refresh),
                                               name: NSView.boundsDidChangeNotification, object: clip)
        observing = true
    }

    override func draw(_ dirtyRect: NSRect) {
        guard let tv = textView, let lm = tv.layoutManager, let container = tv.textContainer else { return }
        Theme.editor.setFill()
        bounds.fill()
        Theme.border.setFill()
        NSRect(x: bounds.maxX - 1, y: 0, width: 1, height: bounds.height).fill()

        let text = tv.string as NSString
        let visible = lm.glyphRange(forBoundingRect: tv.visibleRect, in: container)
        let attrs: [NSAttributedString.Key: Any] = [
            .font: NSFont.monospacedDigitSystemFont(ofSize: 10.5, weight: .regular),
            .foregroundColor: Theme.dim
        ]
        var glyph = visible.location
        while glyph < NSMaxRange(visible) {
            var lineGlyphRange = NSRange()
            let lineRect = lm.lineFragmentRect(forGlyphAt: glyph, effectiveRange: &lineGlyphRange)
            if NSMaxRange(lineGlyphRange) <= glyph { break }
            let charIndex = lm.characterIndexForGlyph(at: glyph)
            if charIndex != NSNotFound {
                let before = text.substring(with: NSRange(location: 0, length: min(charIndex, text.length)))
                let lineNumber = before.components(separatedBy: "\n").count
                let s = NSAttributedString(string: String(lineNumber), attributes: attrs)
                let sz = s.size()
                let y = lineRect.minY + tv.textContainerOrigin.y
                let p = convert(NSPoint(x: 0, y: y), from: tv)
                s.draw(at: NSPoint(x: bounds.width - 10 - sz.width,
                                   y: p.y + max(0, (lineRect.height - sz.height) / 2)))
            }
            glyph = NSMaxRange(lineGlyphRange)
        }
    }
}

enum LuaHighlight {
    static let font = NSFont(name: "Menlo", size: 13) ?? NSFont.monospacedSystemFont(ofSize: 13, weight: .regular)
    static let italicFont = NSFontManager.shared.convert(font, toHaveTrait: .italicFontMask)
    static let keywordColor = NSColor(srgbRed: 0.78, green: 0.47, blue: 0.87, alpha: 1)
    static let stringColor  = NSColor(srgbRed: 0.60, green: 0.77, blue: 0.47, alpha: 1)
    static let numberColor  = NSColor(srgbRed: 0.83, green: 0.61, blue: 0.40, alpha: 1)
    static let commentColor = NSColor(srgbRed: 0.40, green: 0.44, blue: 0.50, alpha: 1)
    static let fnColor      = NSColor(srgbRed: 0.38, green: 0.68, blue: 0.94, alpha: 1)

    static let keywordRe = try! NSRegularExpression(pattern: "\\b(?:and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|self|then|true|until|while)\\b")
    static let numberRe  = try! NSRegularExpression(pattern: "\\b\\d+(?:\\.\\d+)?\\b")
    static let fnRe      = try! NSRegularExpression(pattern: "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()")
    static let stringRe  = try! NSRegularExpression(pattern: "\"([^\"\\\\\\n]|\\\\.)*\"|'([^'\\\\\\n]|\\\\.)*'")
    static let commentRe = try! NSRegularExpression(pattern: "--\\[\\[[\\s\\S]*?\\]\\]|--[^\\n]*")

    static func paint(_ range: NSRange, _ color: NSColor, _ f: NSFont, on ts: NSTextStorage) {
        if range.location != NSNotFound && NSMaxRange(range) <= ts.length {
            ts.addAttribute(.foregroundColor, value: color, range: range)
            if f !== font { ts.addAttribute(.font, value: f, range: range) }
        }
    }

    static func apply(to editor: NSTextView) {
        guard let ts = editor.textStorage else { return }
        let full = NSRange(location: 0, length: (ts.string as NSString).length)
        ts.beginEditing()
        ts.setAttributes([.font: font, .foregroundColor: Theme.text], range: full)
        keywordRe.enumerateMatches(in: ts.string, options: [], range: full) { m, _, _ in
            if let m = m { paint(m.range, keywordColor, font, on: ts) }
        }
        numberRe.enumerateMatches(in: ts.string, options: [], range: full) { m, _, _ in
            if let m = m { paint(m.range, numberColor, font, on: ts) }
        }
        fnRe.enumerateMatches(in: ts.string, options: [], range: full) { m, _, _ in
            if let m = m { paint(m.range, fnColor, font, on: ts) }
        }
        stringRe.enumerateMatches(in: ts.string, options: [], range: full) { m, _, _ in
            if let m = m { paint(m.range, stringColor, font, on: ts) }
        }
        commentRe.enumerateMatches(in: ts.string, options: [], range: full) { m, _, _ in
            if let m = m { paint(m.range, commentColor, italicFont, on: ts) }
        }
        ts.endEditing()
        editor.typingAttributes = [.font: font, .foregroundColor: Theme.text]
    }
}

final class OpexApp: NSObject, NSApplicationDelegate, NSTextViewDelegate,
                     NSTableViewDataSource, NSTableViewDelegate,
                     NSSearchFieldDelegate, NSControlTextEditingDelegate {

    var window: NSWindow!
    var table: NSTableView!
    var editor: NSTextView!
    var gutter: GutterView!
    var status: NSTextField!
    var interpLabel: NSTextField!
    var tabLabel: NSTextField!
    var console: NSTextView!
    var btnConsoleTab: TextButton!
    var btnProblemsTab: TextButton!
    var collapseBtn: TextButton!
    var searchField: NSSearchField!
    var linkValue: NSTextField!
    var autoexecMenuItem: NSMenuItem!

    var allFiles: [String] = []
    var files: [String] = []
    var linkedPath: String?
    var currentFile: String?
    var luaPath: String?
    var luacPath: String?

    var consoleAttr = NSMutableAttributedString()
    var problemsAttr = NSMutableAttributedString()
    var activeTab = 0
    var collapsed = false
    var consoleHeight: NSLayoutConstraint!

    func applicationDidFinishLaunching(_ note: Notification) {
        linkedPath = loadLink()
        luaPath  = resolveLua()
        luacPath = resolveLuac()
        buildMenu()
        buildWindow()
        reloadFiles()
        refreshStatus()
        window.center()
        window.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)

        if linkedPath == nil {
            openFinderAtRoblox()
            if let p = pickFolder() {
                linkedPath = p
                saveLink(p)
                reloadFiles()
                refreshStatus()
            }
        }

        log("Opex-MacOS console ready.", Theme.dim)
        if let lp = luaPath {
            log("✔ Lua ready: \(lp) — Execute (⌘R) works out of the box.", Theme.green)
        } else {
            log("✖ Lua not found. Re-run the installer, or: brew install lua", Theme.red)
        }

        if autoexecEnabled() { runAutoexec() }
    }

    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool { true }

    func autoexecDir() -> URL? {
        guard let lp = linkedPath else { return nil }
        let dir = URL(fileURLWithPath: lp).appendingPathComponent("autoexec", isDirectory: true)
        ensureDir(dir)
        return dir
    }

    func runAutoexec() {
        guard let dir = autoexecDir(), let lua = luaPath else { return }
        guard let items = try? FM.contentsOfDirectory(atPath: dir.path) else { return }
        let scripts = items.filter { $0.hasSuffix(".lua") }.sorted { $0.localizedStandardCompare($1) == .orderedAscending }
        guard !scripts.isEmpty else { return }
        log("⚡ Auto-executing \(scripts.count) script(s) from autoexec/ …", Theme.accent, bold: true)
        for s in scripts {
            let url = dir.appendingPathComponent(s)
            log("  ▶ \(s)", Theme.dim)
            runProcess(lua, [url.path]) { [weak self] out, err, code in
                guard let self = self else { return }
                let o = out.trimmingCharacters(in: .whitespacesAndNewlines)
                let e = err.trimmingCharacters(in: .whitespacesAndNewlines)
                if !o.isEmpty { self.log(o, Theme.text) }
                if !e.isEmpty { self.log(e, Theme.red) }
                self.log(code == 0 ? "  ✔ \(s) finished" : "  ✖ \(s) exited \(code)",
                         code == 0 ? Theme.green : Theme.red)
            }
        }
    }

    @objc func toggleAutoexec() {
        let now = !autoexecEnabled()
        setAutoexec(now)
        autoexecMenuItem?.state = now ? .on : .off
        log(now ? "⚡ Auto-execute: ON (autoexec/ runs at launch)" : "⚡ Auto-execute: OFF",
            Theme.green, bold: true)
    }

    @objc func openAutoexecFolder() {
        guard let dir = autoexecDir() else { askLinkFirst(); return }
        revealInFinder(dir.path)
    }

    @objc func openRoblox() {
        var appURL: URL?
        for p in ["/Applications/Roblox.app", robloxAppUserPath.path] {
            if FM.fileExists(atPath: p) { appURL = URL(fileURLWithPath: p); break }
        }
        if let u = appURL {
            if #available(macOS 11.0, *) {
                NSWorkspace.shared.openApplication(at: u, configuration: NSWorkspace.OpenConfiguration()) { _, _ in }
            } else {
                NSWorkspace.shared.launchApplication("Roblox")
            }
            log("→ Roblox launched.", Theme.green, bold: true)
        } else {
            log("✖ Roblox.app not found in /Applications — install it from roblox.com first.", Theme.red, bold: true)
        }
    }

    func buildMenu() {
        let main = NSMenu()

        let appItem = NSMenuItem()
        let appMenu = NSMenu()
        appMenu.addItem(NSMenuItem(title: "Quit Opex-MacOS",
                                   action: #selector(NSApplication.terminate(_:)), keyEquivalent: "q"))
        appItem.submenu = appMenu
        main.addItem(appItem)

        let fileItem = NSMenuItem()
        let fileMenu = NSMenu(title: "File")
        for (t, s, k) in [("New Script", #selector(newScript), "n"),
                          ("Save", #selector(saveScript), "s"),
                          ("Reveal in Finder", #selector(revealFolder), "r")] {
            let it = NSMenuItem(title: t, action: s, keyEquivalent: k)
            it.target = self
            fileMenu.addItem(it)
