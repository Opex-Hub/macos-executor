    @objc func execute() {
        guard let lp = linkedPath, let f = currentFile else {
            log("⚠ No script selected.", Theme.dim, bold: true); return
        }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(f)
        try? editor.string.write(to: url, atomically: true, encoding: .utf8)
        showTab(0)
        guard let lua = luaPath ?? resolveLua() else {
            log("✖ Lua not found. Re-run the installer, or: brew install lua", Theme.red, bold: true)
            return
        }
        log("▶ Executing \(f) …", Theme.accent, bold: true)

        let preludeURL = FileManager.default.temporaryDirectory
            .appendingPathComponent("opex-prelude-\(UUID().uuidString).lua")
        let prelude = """
        local target = arg[1]
        local chunk, lerr = loadfile(target)
        if not chunk then
            io.stderr:write("=== LOAD ERROR ===\\n" .. tostring(lerr) .. "\\n")
            os.exit(2)
        end
        local ok, rerr = pcall(chunk)
        if not ok then
            io.stderr:write("=== RUNTIME ERROR ===\\n" .. tostring(rerr) .. "\\n")
            io.stderr:write("(If this mentions game, Instance, Players, workspace, etc., " ..
                            "this is a Roblox script and cannot run outside the Roblox client.)\\n")
            os.exit(3)
        end
        """
        try? prelude.write(to: preludeURL, atomically: true, encoding: .utf8)

        runProcess(lua, [preludeURL.path, url.path]) { [weak self] out, err, code in
            guard let self = self else { return }
            try? FileManager.default.removeItem(at: preludeURL)
            let o = out.trimmingCharacters(in: .whitespacesAndNewlines)
            let e = err.trimmingCharacters(in: .whitespacesAndNewlines)
            if !o.isEmpty { self.log(o, Theme.text) }
            if !e.isEmpty { self.log(e, Theme.red) }
            switch code {
            case 0:  self.log("✔ Finished (exit 0)", Theme.green, bold: true)
            case 2:  self.log("✖ Script failed to load — see LOAD ERROR above.", Theme.red, bold: true)
            case 3:  self.log("✖ Script raised a runtime error — see RUNTIME ERROR above.", Theme.red, bold: true)
            default: self.log("✖ Exited with code \(code)", Theme.red, bold: true)
            }
        }
    }

    @objc func checkProblems() {
        guard let lp = linkedPath, let f = currentFile else { return }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(f)
        try? editor.string.write(to: url, atomically: true, encoding: .utf8)
        problemsAttr = NSMutableAttributedString()
        appendTo(problemsAttr, "Checking \(f) …", Theme.dim, bold: false)
        showTab(1)
        guard let luac = luacPath ?? resolveLuac() else {
            appendTo(problemsAttr, "⚠ luac not found — syntax checks unavailable.", Theme.dim, bold: false)
            refreshVisible(); return
        }
        runProcess(luac, ["-p", url.path]) { [weak self] out, err, code in
            guard let self = self else { return }
            if code == 0 {
                self.appendTo(self.problemsAttr, "✔ No syntax problems detected.", Theme.green, bold: true)
            } else {
                let e = err.isEmpty ? out : err
                self.appendTo(self.problemsAttr, e.trimmingCharacters(in: .whitespacesAndNewlines), Theme.red, bold: false)
            }
            self.refreshVisible()
        }
    }

    func appendTo(_ attr: NSMutableAttributedString, _ s: String, _ color: NSColor, bold: Bool) {
        attr.append(NSAttributedString(string: s + "\n", attributes: [
            .font: NSFont.monospacedSystemFont(ofSize: 11.5, weight: bold ? .semibold : .regular),
            .foregroundColor: color
        ]))
    }
    func log(_ s: String, _ color: NSColor = Theme.text, bold: Bool = false) {
        appendTo(consoleAttr, s, color, bold: bold)
        refreshVisible()
    }
    func refreshVisible() {
        console.textStorage?.setAttributedString(activeTab == 0 ? consoleAttr : problemsAttr)
        console.scrollToEndOfDocument(nil)
    }
    func showTab(_ idx: Int) {
        activeTab = idx
        btnConsoleTab.setActive(idx == 0)
        btnProblemsTab.setActive(idx == 1)
        refreshVisible()
    }
    @objc func showConsoleTab()   { showTab(0) }
    @objc func showProblemsTab()  { showTab(1) }
    @objc func clearConsole() {
        if activeTab == 0 { consoleAttr = NSMutableAttributedString() } else { problemsAttr = NSMutableAttributedString() }
        refreshVisible()
    }
    @objc func toggleConsole() {
        collapsed.toggle()
        let target: CGFloat = collapsed ? 27 : 170
        NSAnimationContext.runAnimationGroup({ ctx in
            ctx.duration = 0.22
            ctx.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
            consoleHeight.animator().constant = target
        })
        collapseBtn.setGlyph(collapsed ? "▴" : "▾")
    }

    func refreshStatus() {
        if let lp = linkedPath {
            status.stringValue = "Linked: \(lp)"
            linkValue.stringValue = (lp as NSString).abbreviatingWithTildeInPath
        } else {
            status.stringValue = "Not linked — click Link… or run: opex link"
            linkValue.stringValue = "none"
        }
        if luaPath != nil {
            let bundled = appSupportPath.appendingPathComponent("bin/lua").path
            interpLabel.stringValue = luaPath == bundled ? "Lua: ready (bundled)" : "Lua: ready"
        } else {
            interpLabel.stringValue = "Lua: missing — re-run installer"
        }
    }

    func reloadFiles() {
        allFiles.removeAll()
        if let lp = linkedPath, let items = try? FM.contentsOfDirectory(atPath: lp) {
            allFiles = items
                .filter { ["lua", "txt", "rbxm", "rbxmx", "json"].contains(($0 as NSString).pathExtension) }
                .sorted { $0.localizedStandardCompare($1) == .orderedAscending }
        }
        filterFiles()
    }

    func filterFiles() {
        let q = searchField.stringValue
        files = q.isEmpty ? allFiles : allFiles.filter { $0.localizedCaseInsensitiveContains(q) }
        table.reloadData()
        if !files.isEmpty {
            table.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
        } else {
            currentFile = nil
            editor.string = ""
            updateTabLabel()
        }
    }

    func loadSelected() {
        let row = table.selectedRow
        guard row >= 0, row < files.count, let lp = linkedPath else { currentFile = nil; updateTabLabel(); return }
        currentFile = files[row]
        let url = URL(fileURLWithPath: lp).appendingPathComponent(files[row])
        editor.string = (try? String(contentsOf: url, encoding: .utf8)) ?? ""
        LuaHighlight.apply(to: editor)
        gutter.refresh()
        updateTabLabel()
    }

    func updateTabLabel() {
        let dotColor = currentFile == nil ? Theme.dim : Theme.green
        let s = NSMutableAttributedString(string: "●  ", attributes: [
            .foregroundColor: dotColor, .font: NSFont.systemFont(ofSize: 11)
        ])
        s.append(NSAttributedString(string: currentFile ?? "No file", attributes: [
            .foregroundColor: Theme.text, .font: NSFont.systemFont(ofSize: 12, weight: .medium)
        ]))
        tabLabel.attributedStringValue = s
    }

    func controlTextDidChange(_ obj: Notification) { filterFiles() }

    func textDidChange(_ notification: Notification) {
        LuaHighlight.apply(to: editor)
        gutter.refresh()
    }

    func numberOfRows(in tableView: NSTableView) -> Int { files.count }

    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
        let id = NSUserInterfaceItemIdentifier("cell")
        let label: NSTextField
        if let v = table.makeView(withIdentifier: id, owner: nil) as? NSTextField {
            label = v
        } else {
            label = NSTextField(labelWithString: "")
            label.identifier = id
            label.lineBreakMode = .byTruncatingMiddle
            label.font = NSFont.systemFont(ofSize: 12)
        }
        label.textColor = Theme.text
        label.stringValue = files[row]
        return label
    }

    func tableViewSelectionDidChange(_ notification: Notification) { loadSelected() }
