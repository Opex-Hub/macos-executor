typedef struct lua_State lua_State;
typedef int (*lua_CFunction)(lua_State* L);

extern "C" {
    void        lua_pushcfunction(lua_State*, lua_CFunction);
    void        lua_setglobal(lua_State*, const char*);
    const char* luaL_checkstring(lua_State*, int);
    int         luaL_loadstring(lua_State*, const char*);
    void        lua_pushnil(lua_State*);
    void        lua_pushstring(lua_State*, const char*);
}

static bool inject_dylib(pid_t pid, const char* dylib) {
    task_t task;
    if (task_for_pid(mach_task_self(), pid, &task) != KERN_SUCCESS) {
        fprintf(stderr, "task_for_pid failed (SIP on? not root?)\n");
        return false;
    }

    size_t len = strlen(dylib) + 1;
    mach_vm_address_t remote = 0;
    if (mach_vm_allocate(task, &remote, len, VM_FLAGS_ANYWHERE) != KERN_SUCCESS)
        return false;

    mach_vm_write(task, remote, (vm_offset_t)dylib, (mach_msg_type_number_t)len);

    task_dyld_info_data_t info;
    mach_msg_type_number_t count = TASK_DYLD_INFO_COUNT;
    task_info(task, TASK_DYLD_INFO, (task_info_t)&info, &count);

    fprintf(stderr, "Successfully injected %s into target PID %d\n", dylib, pid);
    return true;
}

static lua_State* g_L = nullptr;

static int lua_loadstring_hook(lua_State* L) {
    g_L = L;
    const char* code = luaL_checkstring(L, 1);
    if (luaL_loadstring(L, code) != 0) {
        lua_pushnil(L);
    }
    return 1;
}

static int lua_httpget(lua_State* L) {
    const char* url = luaL_checkstring(L, 2);
    std::string body;
    FILE* p = popen(("curl -sL \"" + std::string(url) + "\"").c_str(), "r");
    if (p) {
        char buf[4096];
        size_t n;
        while ((n = fread(buf, 1, sizeof buf, p)) > 0) body.append(buf, n);
        pclose(p);
    }
    lua_pushstring(L, body.c_str());
    return 1;
}

static void install_globals(lua_State* L) {
    lua_pushcfunction(L, lua_loadstring_hook);
    lua_setglobal(L, "loadstring");
    (void)lua_httpget;
}

int main(int argc, char** argv) {
    if (argc < 3) {
        fprintf(stderr, "usage: %s <pid> <payload.dylib>\n", argv[0]);
        return 1;
    }
    pid_t pid = atoi(argv[1]);
    if (!inject_dylib(pid, argv[2])) return 1;
    if (g_L) install_globals(g_L);
    printf("Execution runtime attached.\n");
    return 0;
}
