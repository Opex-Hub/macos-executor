        fileMenu.addItem(.separator())
        let link = NSMenuItem(title: "Link Folder…", action: #selector(linkFolder), keyEquivalent: "l")
        link.target = self
        fileMenu.addItem(link)
        fileItem.submenu = fileMenu
        main.addItem(fileItem)

        let scriptItem = NSMenuItem()
        let scriptMenu = NSMenu(title: "Script")

        let run = NSMenuItem(title: "Execute", action: #selector(execute), keyEquivalent: "r")
        run.target = self
        scriptMenu.addItem(run)

        let check = NSMenuItem(title: "Check Syntax", action: #selector(checkProblems), keyEquivalent: "p")
        check.keyEquivalentModifierMask = [.command, .shift]
        check.target = self
        scriptMenu.addItem(check)

        scriptMenu.addItem(.separator())

        autoexecMenuItem = NSMenuItem(title: "Auto-Execute on Launch", action: #selector(toggleAutoexec), keyEquivalent: "e")
        autoexecMenuItem.keyEquivalentModifierMask = [.command, .shift]
        autoexecMenuItem.target = self
        autoexecMenuItem.state = autoexecEnabled() ? .on : .off
        scriptMenu.addItem(autoexecMenuItem)

        let aeFolder = NSMenuItem(title: "Open Autoexec Folder", action: #selector(openAutoexecFolder), keyEquivalent: "")
        aeFolder.target = self
        scriptMenu.addItem(aeFolder)

        scriptMenu.addItem(.separator())

        let rbx = NSMenuItem(title: "Open Roblox", action: #selector(openRoblox), keyEquivalent: "o")
        rbx.target = self
        scriptMenu.addItem(rbx)

        scriptItem.submenu = scriptMenu
        main.addItem(scriptItem)

        let helpItem = NSMenuItem()
        let helpMenu = NSMenu(title: "Help")
        let about = NSMenuItem(title: "About Opex-MacOS", action: #selector(showAbout), keyEquivalent: "")
        about.target = self
        helpMenu.addItem(about)
        helpItem.submenu = helpMenu
        main.addItem(helpItem)

        NSApp.mainMenu = main
    }

    @objc func showAbout() {
        let a = NSAlert()
        a.messageText = "Opex-MacOS"
        a.informativeText = """
        Lua script workspace for your Roblox folder.

        Version 2.2.0 — Swift, no dependencies, bundled Lua.

        • Execute runs scripts with the bundled Lua interpreter.
        • Scripts in the autoexec/ folder run automatically at launch.
        • Open Roblox launches the Roblox app.
        """
        a.runModal()
    }

    func buildWindow() {
        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 1100, height: 700),
                          styleMask: [.titled, .closable, .miniaturizable, .resizable],
                          backing: .buffered, defer: false)
        window.title = "Opex-MacOS"
        window.appearance = NSAppearance(named: .darkAqua)
        window.titlebarAppearsTransparent = true
        window.backgroundColor = Theme.bg
        window.minSize = NSSize(width: 880, height: 560)
        guard let content = window.contentView else { return }
        content.wantsLayer = true
        content.layer?.backgroundColor = Theme.bg.cgColor

        let toolbar = solidView(Theme.bg)
        content.addSubview(toolbar)
        toolbar.translatesAutoresizingMaskIntoConstraints = false

        let brand = NSTextField(labelWithString: "Opex-MacOS")
        brand.font = NSFont.systemFont(ofSize: 14, weight: .bold)
        brand.textColor = Theme.text
        toolbar.addSubview(brand)
        brand.translatesAutoresizingMaskIntoConstraints = false

        let btnExecute = PillButton(title: "▶  Execute", base: Theme.accent, textColor: .white,
                                    target: self, action: #selector(execute), tooltip: "Run the current script (⌘R)")
