    func openFile(_ name: String) {
        guard let p = linkedPath else { return }
        currentFile = name
        tabLabel.stringValue = name
        let url = URL(fileURLWithPath: p).appendingPathComponent(name)
        let text = (try? String(contentsOf: url, encoding: .utf8)) ?? ""
        editor.string = text
        LuaHighlight.apply(to: editor)
        gutter.refresh()
        status.stringValue = "Opened \(name)"
    }

    @objc func newScript() {
        guard let p = linkedPath else { askLinkFirst(); return }
        let alert = NSAlert()
        alert.messageText = "New Script"
        alert.informativeText = "Enter script name (e.g. main.lua):"
        let input = NSTextField(frame: NSRect(x: 0, y: 0, width: 240, height: 24))
        input.stringValue = "script.lua"
        alert.accessoryView = input
        alert.addButton(withTitle: "Create")
        alert.addButton(withTitle: "Cancel")
        if alert.runModal() == .alertFirstButtonReturn {
            var name = input.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
            if name.isEmpty { return }
            if !name.hasSuffix(".lua") { name += ".lua" }
            let url = URL(fileURLWithPath: p).appendingPathComponent(name)
            try? "-- \(name)\nprint(\"Hello from \(name)\")\n".write(to: url, atomically: true, encoding: .utf8)
            reloadFiles()
            if let idx = files.firstIndex(of: name) {
                table.selectRowIndexes(IndexSet(integer: idx), byExtendingSelection: false)
            }
        }
    }

    @objc func saveScript() {
        guard let p = linkedPath, let f = currentFile else { return }
        let url = URL(fileURLWithPath: p).appendingPathComponent(f)
        try? editor.string.write(to: url, atomically: true, encoding: .utf8)
        status.stringValue = "Saved \(f)"
    }

    @objc func deleteScript() {
        guard let p = linkedPath, let f = currentFile else { return }
        let alert = NSAlert()
        alert.messageText = "Delete \(f)?"
        alert.informativeText = "This action cannot be undone."
        alert.addButton(withTitle: "Delete")
        alert.addButton(withTitle: "Cancel")
        if alert.runModal() == .alertFirstButtonReturn {
            let url = URL(fileURLWithPath: p).appendingPathComponent(f)
            try? FM.removeItem(at: url)
            currentFile = nil
            tabLabel.stringValue = "Untitled.lua"
            editor.string = ""
            reloadFiles()
        }
    }

    @objc func execute() {
        saveScript()
        guard let lua = luaPath else {
            log("✖ Execution failed: No Lua interpreter configured.", Theme.red, bold: true)
            return
        }
        guard let p = linkedPath, let f = currentFile else {
            log("✖ Select or create a script first.", Theme.red)
            return
        }
        let url = URL(fileURLWithPath: p).appendingPathComponent(f)
        log("▶ Executing \(f) …", Theme.accent, bold: true)
        runProcess(lua, [url.path]) { [weak self] out, err, code in
            guard let self = self else { return }
            let o = out.trimmingCharacters(in: .whitespacesAndNewlines)
            let e = err.trimmingCharacters(in: .whitespacesAndNewlines)
            if !o.isEmpty { self.log(o, Theme.text) }
            if !e.isEmpty { self.log(e, Theme.red) }
            self.log(code == 0 ? "✔ Process finished with code 0" : "✖ Process exited with code \(code)",
                     code == 0 ? Theme.green : Theme.red)
        }
    }

    @objc func checkProblems() {
        saveScript()
        guard let luac = luacPath else {
            log("✖ Syntax check failed: luac not found.", Theme.red)
            return
        }
        guard let p = linkedPath, let f = currentFile else { return }
        let url = URL(fileURLWithPath: p).appendingPathComponent(f)
        runProcess(luac, ["-p", url.path]) { [weak self] _, err, code in
            guard let self = self else { return }
            self.problemsAttr = NSMutableAttributedString()
            if code == 0 {
                self.appendAttr(self.problemsAttr, "✔ No syntax errors detected in \(f)\n", Theme.green, bold: true)
            } else {
                let cleanErr = err.replacingOccurrences(of: url.path + ":", with: "Line ")
                self.appendAttr(self.problemsAttr, "✖ Syntax error in \(f):\n\(cleanErr)\n", Theme.red, bold: true)
            }
            if self.activeTab == 1 { self.renderConsole() }
            self.showProblemsTab()
        }
    }

    @objc func revealFolder() {
        guard let p = linkedPath else { askLinkFirst(); return }
        revealInFinder(p)
    }

    @objc func linkFolder() {
        if let p = pickFolder() {
            linkedPath = p
            saveLink(p)
            reloadFiles()
            refreshStatus()
        }
    }

    func askLinkFirst() {
        openFinderAtRoblox()
        linkFolder()
    }

    func openFinderAtRoblox() {
        ensureDir(robloxClientFolder)
        revealInFinder(robloxClientFolder.path)
    }

    func pickFolder() -> String? {
        let open = NSOpenPanel()
        open.title = "Select your Roblox workspace folder"
        open.prompt = "Link Folder"
        open.canChooseDirectories = true
        open.canChooseFiles = false
        open.allowsMultipleSelection = false
        open.directoryURL = robloxClientFolder
        return open.runModal() == .OK ? open.url?.path : nil
    }

    func refreshStatus() {
        if let p = linkedPath {
            let name = (p as NSString).lastPathComponent
            linkValue.stringValue = "Linked: \(name)"
        } else {
            linkValue.stringValue = "Not linked"
        }
        if let lp = luaPath {
            let name = (lp as NSString).lastPathComponent
            interpLabel.stringValue = "Lua: \(name)"
        } else {
            interpLabel.stringValue = "Lua: Missing"
        }
    }

    func log(_ text: String, _ color: NSColor, bold: Bool = false) {
        appendAttr(consoleAttr, text + "\n", color, bold: bold)
        if activeTab == 0 { renderConsole() }
    }

    func appendAttr(_ target: NSMutableAttributedString, _ text: String, _ color: NSColor, bold: Bool = false) {
        let f = bold ? NSFont.monospacedSystemFont(ofSize: 11.5, weight: .bold)
                     : NSFont.monospacedSystemFont(ofSize: 11.5, weight: .regular)
        let attrs: [NSAttributedString.Key: Any] = [.foregroundColor: color, .font: f]
        target.append(NSAttributedString(string: text, attributes: attrs))
    }

    func renderConsole() {
        console.textStorage?.setAttributedString(activeTab == 0 ? consoleAttr : problemsAttr)
        console.scrollToEndOfDocument(nil)
    }

    @objc func showConsoleTab() {
        activeTab = 0
        btnConsoleTab.setActive(true)
        btnProblemsTab.setActive(false)
        renderConsole()
    }

    @objc func showProblemsTab() {
        activeTab = 1
        btnConsoleTab.setActive(false)
        btnProblemsTab.setActive(true)
        renderConsole()
    }

    @objc func clearConsole() {
        if activeTab == 0 { consoleAttr = NSMutableAttributedString() }
        else { problemsAttr = NSMutableAttributedString() }
        renderConsole()
    }

    @objc func toggleCollapse() {
        collapsed.toggle()
        consoleHeight.constant = collapsed ? 28 : 160
        collapseBtn.setGlyph(collapsed ? "▲" : "▼")
        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = 0.15
            window.contentView?.layoutSubtreeIfNeeded()
        }
    }
}

