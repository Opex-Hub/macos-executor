    var consoleAttr = NSMutableAttributedString()
    var problemsAttr = NSMutableAttributedString()
    var activeTab = 0
    var collapsed = false
    var consoleHeight: NSLayoutConstraint!

    // ---------- Lifecycle ----------

    func applicationDidFinishLaunching(_ note: Notification) {
        linkedPath = loadLink()
        luaPath = findBinary(["lua", "lua5.4", "lua5.3", "luajit"])
        buildMenu()
        buildWindow()
        reloadFiles()
        refreshStatus()
        window.center()
        window.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)

        if linkedPath == nil {
            openFinderAtRoblox()
            if let p = pickFolder() {
                linkedPath = p
                saveLink(p)
                reloadFiles()
                refreshStatus()
            }
        }

        log("Opex-MacOS console ready.", Theme.dim)
        if let lp = luaPath {
            log("✔ Lua interpreter found: \(lp) — Execute (⌘R) is live.", Theme.green)
        } else {
            log("⚠ Lua interpreter not found — run 'brew install lua' to enable Execute.", Theme.dim)
        }
    }

    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool { true }

    // ---------- Menu ----------

