# ----------------------------------------------------------
step_msg "${YELLOW}[*] Step 3/5 — Creating app bundle...${NC}"
cat > "$SCRIPT_DIR/src/Info.plist" <<'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Opex-MacOS</string>
  <key>CFBundleDisplayName</key><string>Opex-MacOS</string>
  <key>CFBundleIdentifier</key><string>com.opex.macos</string>
  <key>CFBundleExecutable</key><string>Opex-MacOS</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>2.1.1</string>
  <key>CFBundleVersion</key><string>3</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
</dict>
</plist>
PLIST_EOF
set_progress 28

# ----------------------------------------------------------
# Step 4: Build (with live # progress bar)
# ----------------------------------------------------------
step_msg "${YELLOW}[*] Step 4/5 — Building Opex-MacOS...${NC}"
mkdir -p "$BUILD_DIR"

(
    [ "$IS_TTY" -eq 1 ] || exit 0
    pct=$CURRENT_PCT
    while true; do
        if [ "$pct" -lt 90 ]; then
            inc=$(( pct < 50 ? 3 : (pct < 80 ? 2 : 1) ))
            pct=$(( pct + inc ))
            draw_bar "$pct"
        fi
        sleep 0.7
    done
) &
CREEP_PID=$!
trap 'kill $CREEP_PID 2>/dev/null' EXIT

BUILD_STATUS=0
swiftc "$SCRIPT_DIR/src/main.swift" -o "$BUILD_DIR/$APP_NAME" -framework AppKit || BUILD_STATUS=$?

kill $CREEP_PID 2>/dev/null || true
wait $CREEP_PID 2>/dev/null || true
sleep 0.05

if [ $BUILD_STATUS -ne 0 ]; then
    printf "\r\033[K"
    echo -e "${RED}[!] Build failed — see compiler errors above.${NC}"
    exit 1
fi
set_progress 92

mkdir -p "$APP_PATH/Contents/MacOS" "$APP_PATH/Contents/Resources"
cp "$BUILD_DIR/$APP_NAME" "$APP_PATH/Contents/MacOS/$APP_NAME"
cp "$SCRIPT_DIR/src/Info.plist" "$APP_PATH/Contents/Info.plist"
codesign --force -s - "$APP_PATH" 2>/dev/null || true
set_progress 94

# ----------------------------------------------------------
# Step 5: CLI install
# ----------------------------------------------------------
step_msg "${YELLOW}[*] Step 5/5 — Installing CLI tool...${NC}"
BIN_DIR=""
for dir in "$HOME/.local/bin" "$HOME/bin" "/usr/local/bin"; do
    if mkdir -p "$dir" 2>/dev/null && [ -w "$dir" ]; then BIN_DIR="$dir"; break; fi
done
if [ -z "$BIN_DIR" ]; then
    step_msg "${YELLOW}[!] No writable bin folder — skipping CLI. App still works: open $APP_PATH${NC}"
else
    cp "$BUILD_DIR/$APP_NAME" "$BIN_DIR/opex"
    chmod +x "$BIN_DIR/opex"
    if ! echo "$PATH" | grep -q "$BIN_DIR"; then
        SHELL_RC="$HOME/.zshrc"
        if [ -f "$HOME/.bashrc" ] && [ "$SHELL" = "/bin/bash" ]; then SHELL_RC="$HOME/.bashrc"; fi
        if ! grep -q "$BIN_DIR" "$SHELL_RC" 2>/dev/null; then
            echo "export PATH=\"$BIN_DIR:\$PATH\"" >> "$SHELL_RC"
        fi
    fi
fi
set_progress 98

cat > "$SCRIPT_DIR/README.md" <<'README_EOF'
# Opex-MacOS

Fancy native macOS Lua script workspace with a dark IDE-style UI — syntax highlighting,
line numbers, console output, and a Roblox-folder connection.

## Install
bash -c "$(curl -fsSL https://raw.githubusercontent.com/Opex-Hub/macos-executor/refs/heads/main/opex)"

## Enable Execute (runs Lua locally)
brew install lua

## CLI
opex                 # open the app
opex link            # pick your Roblox folder
opex run script.lua  # execute a script locally
opex list            # list scripts
README_EOF

# ----------------------------------------------------------
# Done
# ----------------------------------------------------------
set_progress 100
echo ""
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║        ✔  100% — Install Complete        ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════╝${NC}"
echo ""
echo -e "  ${CYAN}App:${NC}      $APP_PATH"
echo -e "  ${CYAN}CLI:${NC}      ${BIN_DIR:-skipped}/opex"
echo ""

if [ -t 0 ]; then
    read -p "Launch Opex-MacOS now? [Y/n] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then open "$APP_PATH"; fi
else
    open "$APP_PATH"
fi
echo -e "${GREEN}[✔] Done.${NC}"
