    // ---------- Actions ----------

    @objc func newScript() {
        guard let lp = linkedPath else { askLinkFirst(); return }
        var i = 1
        while FM.fileExists(atPath: URL(fileURLWithPath: lp).appendingPathComponent("Untitled-\(i).lua").path) { i += 1 }
        let name = "Untitled-\(i).lua"
        _ = FM.createFile(atPath: URL(fileURLWithPath: lp).appendingPathComponent(name).path,
                          contents: Data("-- Opex-MacOS script\n".utf8))
        reloadFiles()
        if let idx = files.firstIndex(of: name) {
            table.selectRowIndexes(IndexSet(integer: idx), byExtendingSelection: false)
        }
    }

    @objc func saveScript() {
        guard let lp = linkedPath, let f = currentFile else { return }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(f)
        do { try editor.string.write(to: url, atomically: true, encoding: .utf8) } catch { return }
        log("💾 Saved \(f)", Theme.dim)
        refreshStatus()
    }

    @objc func deleteScript() {
        guard let lp = linkedPath, let f = currentFile else { return }
        let alert = NSAlert()
        alert.messageText = "Delete \(f)?"
        alert.addButton(withTitle: "Delete")
        alert.addButton(withTitle: "Cancel")
        if alert.runModal() == .alertFirstButtonReturn {
            try? FM.removeItem(at: URL(fileURLWithPath: lp).appendingPathComponent(f))
            reloadFiles()
            refreshStatus()
        }
    }

    @objc func revealFolder() {
        guard let lp = linkedPath else { askLinkFirst(); return }
        revealInFinder(lp)
    }

    @objc func linkFolder() {
        if let p = pickFolder() {
            linkedPath = p
            saveLink(p)
            reloadFiles()
            refreshStatus()
        }
    }

    func askLinkFirst() {
        let alert = NSAlert()
        alert.messageText = "No folder linked"
        alert.informativeText = "Choose the folder Opex-MacOS should save scripts into."
        alert.addButton(withTitle: "Choose Folder")
        alert.addButton(withTitle: "Cancel")
        if alert.runModal() == .alertFirstButtonReturn { linkFolder() }
    }

    // ---------- Execute / Check / Studio ----------

    @objc func execute() {
        guard let lp = linkedPath, let f = currentFile else {
            log("⚠ No script selected.", Theme.dim, bold: true); return
        }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(f)
        try? editor.string.write(to: url, atomically: true, encoding: .utf8)
        showTab(0)
        guard let lua = luaPath ?? findBinary(["lua", "lua5.4", "lua5.3", "luajit"]) else {
            log("✖ Lua interpreter not found on this Mac.", Theme.red, bold: true)
            log("  Install it with:  brew install lua", Theme.text)
            log("  Your script is still saved — use “→ Studio” for Roblox Studio.", Theme.dim)
            return
        }
        log("▶ Executing \(f) …", Theme.accent, bold: true)
        runProcess(lua, [url.path]) { [weak self] out, err, code in
            guard let self = self else { return }
            let o = out.trimmingCharacters(in: .whitespacesAndNewlines)
            let e = err.trimmingCharacters(in: .whitespacesAndNewlines)
            if !o.isEmpty { self.log(o, Theme.text) }
            if !e.isEmpty { self.log(e, Theme.red) }
            self.log(code == 0 ? "✔ Finished (exit 0)" : "✖ Exited with code \(code)",
                     code == 0 ? Theme.green : Theme.red, bold: true)
        }
    }

    @objc func checkProblems() {
        guard let lp = linkedPath, let f = currentFile else { return }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(f)
        try? editor.string.write(to: url, atomically: true, encoding: .utf8)
        problemsAttr = NSMutableAttributedString()
        appendTo(problemsAttr, "Checking \(f) …", Theme.dim, bold: false)
        showTab(1)
        guard let luac = findBinary(["luac", "luac5.4", "luac5.3"]) else {
            appendTo(problemsAttr, "⚠ luac not found — install lua for real syntax checks (brew install lua).", Theme.dim, bold: false)
            appendTo(problemsAttr, "No problems detected in the workspace.", Theme.green, bold: true)
            refreshVisible(); return
        }
        runProcess(luac, ["-p", url.path]) { [weak self] out, err, code in
            guard let self = self else { return }
            if code == 0 {
                self.appendTo(self.problemsAttr, "✔ No syntax problems detected.", Theme.green, bold: true)
            } else {
                let e = err.isEmpty ? out : err
                self.appendTo(self.problemsAttr, e.trimmingCharacters(in: .whitespacesAndNewlines), Theme.red, bold: false)
            }
            self.refreshVisible()
        }
    }

    @objc func sendToStudio() {
        guard let lp = linkedPath, let f = currentFile else {
            log("⚠ No script selected.", Theme.dim, bold: true); return
        }
        try? editor.string.write(to: URL(fileURLWithPath: lp).appendingPathComponent(f), atomically: true, encoding: .utf8)
        ensureDir(studioPluginsFolder)
        let src = URL(fileURLWithPath: lp).appendingPathComponent(f)
        let dst = studioPluginsFolder.appendingPathComponent(f)
        try? FM.removeItem(at: dst)
        do {
            try FM.copyItem(at: src, to: dst)
            log("→ Sent to Roblox Studio: \(dst.path)", Theme.green, bold: true)
            log("  Open Roblox Studio → Plugins tab to use it.", Theme.dim)
        } catch {
            log("✖ Copy failed: \(error.localizedDescription)", Theme.red, bold: true)
        }
    }

    // ---------- Console helpers ----------

    func appendTo(_ attr: NSMutableAttributedString, _ s: String, _ color: NSColor, bold: Bool) {
        attr.append(NSAttributedString(string: s + "\n", attributes: [
            .font: NSFont.monospacedSystemFont(ofSize: 11.5, weight: bold ? .semibold : .regular),
            .foregroundColor: color
