    print("""
    Opex-MacOS v2.2 — Lua script workspace for your Roblox folder

    USAGE
      opex                 Open the Opex-MacOS window
      opex link            Choose the Roblox folder to link (Finder picker)
      opex status          Show the currently linked folder
      opex reveal          Reveal the linked folder in Finder
      opex list            List scripts in the linked folder
      opex new <file.lua>  Create a new script in the linked folder
      opex run <file.lua>  Execute a script with the bundled Lua
      opex autoexec on|off Toggle auto-execute on launch
      opex unlink          Remove the link
    """)
}

func handleCLI() -> Bool {
    let args = CommandLine.arguments
    guard args.count > 1 else { return false }
    switch args[1] {
    case "help", "-h", "--help":
        printHelp()
    case "status":
        print(loadLink() ?? "Not linked. Run: opex link")
        print(resolveLua() != nil ? "Lua: ready" : "Lua: missing — re-run installer")
    case "unlink":
        clearLink(); print("Unlinked.")
    case "reveal":
        if let lp = loadLink() { revealInFinder(lp) } else { print("Not linked. Run: opex link") }
    case "list":
        guard let lp = loadLink(), let items = try? FM.contentsOfDirectory(atPath: lp) else {
            print("Not linked. Run: opex link"); break
        }
        let lua = items.filter { $0.hasSuffix(".lua") }.sorted()
        print(lua.isEmpty ? "(no scripts yet)" : lua.joined(separator: "\n"))
    case "new":
        guard let lp = loadLink() else { print("Not linked. Run: opex link"); break }
        let name = args.count > 2 ? args[2] : "untitled.lua"
        let url = URL(fileURLWithPath: lp).appendingPathComponent(name)
        _ = FM.createFile(atPath: url.path, contents: Data("-- Opex-MacOS script\n".utf8))
        print("Created: \(url.path)")
    case "autoexec":
        if args.count > 2 && args[2] == "on"  { setAutoexec(true);  print("Auto-execute: ON") }
        else if args.count > 2 && args[2] == "off" { setAutoexec(false); print("Auto-execute: OFF") }
        else { print("Auto-execute is \(autoexecEnabled() ? "ON" : "OFF") (usage: opex autoexec on|off)") }
    case "run":
        guard let lp = loadLink() else { print("Not linked. Run: opex link"); break }
        guard args.count > 2 else { print("Usage: opex run <file.lua>"); break }
        let url = URL(fileURLWithPath: lp).appendingPathComponent(args[2])
        guard FM.fileExists(atPath: url.path) else { print("File not found: \(url.path)"); break }
        guard let lua = resolveLua() else {
            print("Lua not found. Re-run installer, or: brew install lua"); break
        }
        let p = Process()
        p.executableURL = URL(fileURLWithPath: lua)
        p.arguments = [url.path]
        p.standardOutput = FileHandle.standardOutput
        p.standardError = FileHandle.standardError
        do { try p.run(); p.waitUntilExit() } catch { print("Failed: \(error.localizedDescription)") }
    case "link":
        let app = NSApplication.shared
        app.setActivationPolicy(.accessory)
        if FM.fileExists(atPath: robloxClientFolder.path) {
            revealInFinder(robloxClientFolder.path)
        }
        let panel = NSOpenPanel()
        panel.title = "Opex-MacOS — Link Roblox Folder"
        panel.message = "Click your Roblox folder, then click Open."
        panel.canChooseDirectories = true
        panel.canChooseFiles = false
        panel.canCreateDirectories = true
        panel.prompt = "Open"
        panel.directoryURL = FM.fileExists(atPath: robloxClientFolder.path) ? robloxClientFolder : home
        if panel.runModal() == .OK, let p = panel.url?.path { saveLink(p); print("Linked: \(p)") }
        else { print("Cancelled.") }
    default:
        print("Unknown command: \(args[1])\n")
        printHelp()
    }
    return true
}

if handleCLI() { exit(0) }

