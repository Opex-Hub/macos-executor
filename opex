#!/bin/bash
# ============================================================
#  Opex-MacOS v2.2 — Installer (bundles its own Lua, no brew)
# ============================================================

set -euo pipefail

APP_NAME="Opex-MacOS"
VERSION="2.2.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || pwd)"
if [ ! -w "$SCRIPT_DIR" ]; then SCRIPT_DIR="$HOME"; fi
BUILD_DIR="$SCRIPT_DIR/build"
APP_PATH="$BUILD_DIR/$APP_NAME.app"
OPEX_SUPPORT="$HOME/Library/Application Support/Opex-MacOS"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

IS_TTY=1
[ -t 1 ] || IS_TTY=0
CURRENT_PCT=0
BAR_WIDTH=40

draw_bar() {
    [ "$IS_TTY" -eq 1 ] || return 0
    local pct=${1:-$CURRENT_PCT}
    local filled=$(( BAR_WIDTH * pct / 100 ))
    local empty=$(( BAR_WIDTH - filled ))
    local bar="" i
    for ((i=0; i<filled; i++)); do bar+="#"; done
    for ((i=0; i<empty; i++)); do bar+="·"; done
    printf "\r  ${CYAN}[${NC}${GREEN}${bar}${NC}${CYAN}]${NC} ${BOLD}%3d%%${NC}  " "$pct"
}
set_progress() { CURRENT_PCT=$1; draw_bar; }
step_msg() {
    if [ "$IS_TTY" -eq 1 ]; then
        printf "\r\033[K"
        printf "%b\n" "$1"
        draw_bar
    else
        printf "%b\n" "$1"
    fi
}

echo -e "${CYAN}╔══════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║   Opex-MacOS — Installer v$VERSION        ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════╝${NC}"
echo ""
set_progress 0

step_msg "${YELLOW}[*] Step 1/6 — Checking requirements...${NC}"
if ! xcode-select -p >/dev/null 2>&1; then
    printf "\r\033[K"
    echo -e "${RED}[!] Xcode Command Line Tools not found.${NC}"
    echo "    Run:  xcode-select --install"
    exit 1
fi
set_progress 8

step_msg "${YELLOW}[*] Step 2/6 — Writing Swift source code...${NC}"
mkdir -p "$SCRIPT_DIR/src"

cat > "$SCRIPT_DIR/src/main.swift" <<'SWIFT_EOF'
import AppKit

let FM   = FileManager.default
let home = FM.homeDirectoryForCurrentUser

let appSupportPath      = home.appendingPathComponent("Library/Application Support/Opex-MacOS", isDirectory: true)
let configPath          = appSupportPath.appendingPathComponent("linked-folder.txt")
let autoexecFlagPath    = appSupportPath.appendingPathComponent("autoexec.txt")
let robloxClientFolder  = home.appendingPathComponent("Library/Application Support/Roblox", isDirectory: true)
let robloxAppUserPath   = home.appendingPathComponent("Applications/Roblox.app")

func loadLink() -> String? {
    guard let raw = try? String(contentsOf: configPath, encoding: .utf8) else { return nil }
    let p = raw.trimmingCharacters(in: .whitespacesAndNewlines)
    return p.isEmpty ? nil : p
}
func saveLink(_ path: String) {
    try? FM.createDirectory(at: appSupportPath, withIntermediateDirectories: true)
    try? path.write(to: configPath, atomically: true, encoding: .utf8)
}
func clearLink() { try? FM.removeItem(at: configPath) }
func ensureDir(_ url: URL) {
    if !FM.fileExists(atPath: url.path) { try? FM.createDirectory(at: url, withIntermediateDirectories: true) }
}
func revealInFinder(_ path: String) { NSWorkspace.shared.selectFile(nil, inFileViewerRootedAtPath: path) }

func autoexecEnabled() -> Bool {
    guard let s = try? String(contentsOf: autoexecFlagPath, encoding: .utf8) else { return true }
    return s.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() != "off"
}
func setAutoexec(_ on: Bool) {
    try? FM.createDirectory(at: appSupportPath, withIntermediateDirectories: true)
    try? (on ? "on" : "off").write(to: autoexecFlagPath, atomically: true, encoding: .utf8)
}

func which(_ name: String) -> String? {
    let p = Process()
    p.executableURL = URL(fileURLWithPath: "/usr/bin/which")
    p.arguments = [name]
    let pipe = Pipe()
    p.standardOutput = pipe
    p.standardError = FileHandle.nullDevice
    do { try p.run() } catch { return nil }
    let data = pipe.fileHandleForReading.readDataToEndOfFile()
    p.waitUntilExit()
    let out = String(data: data, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
    return (p.terminationStatus == 0 && !out.isEmpty) ? out : nil
}
func findBinary(_ names: [String]) -> String? {
    for n in names { if let p = which(n) { return p } }
    return nil
}

func resolveLua() -> String? {
    let bundled = appSupportPath.appendingPathComponent("bin/lua")
    if FM.isExecutableFile(atPath: bundled.path) { return bundled.path }
    return findBinary(["lua", "lua5.4", "lua5.3", "luajit"])
}
func resolveLuac() -> String? {
    let bundled = appSupportPath.appendingPathComponent("bin/luac")
    if FM.isExecutableFile(atPath: bundled.path) { return bundled.path }
    return findBinary(["luac", "luac5.4", "luac5.3"])
}

func runProcess(_ path: String, _ args: [String], completion: @escaping (String, String, Int32) -> Void) {
    DispatchQueue.global(qos: .userInitiated).async {
        let p = Process()
        p.executableURL = URL(fileURLWithPath: path)
        p.arguments = args
        let outPipe = Pipe(), errPipe = Pipe()
        p.standardOutput = outPipe
        p.standardError = errPipe
        do { try p.run() } catch {
            DispatchQueue.main.async { completion("", error.localizedDescription, -1) }
            return
        }
        let outData = outPipe.fileHandleForReading.readDataToEndOfFile()
        let errData = errPipe.fileHandleForReading.readDataToEndOfFile()
        p.waitUntilExit()
        let out = String(data: outData, encoding: .utf8) ?? ""
        let err = String(data: errData, encoding: .utf8) ?? ""
        DispatchQueue.main.async { completion(out, err, p.terminationStatus) }
    }
}

