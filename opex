    func log(_ s: String, _ color: NSColor = Theme.text, bold: Bool = false) {
        appendTo(consoleAttr, s, color, bold: bold)
        refreshVisible()
    }
    func refreshVisible() {
        console.textStorage?.setAttributedString(activeTab == 0 ? consoleAttr : problemsAttr)
        console.scrollToEndOfDocument(nil)
    }
    func showTab(_ idx: Int) {
        activeTab = idx
        btnConsoleTab.setActive(idx == 0)
        btnProblemsTab.setActive(idx == 1)
        refreshVisible()
    }
    @objc func showConsoleTab()   { showTab(0) }
    @objc func showProblemsTab()  { showTab(1) }
    @objc func clearConsole() {
        if activeTab == 0 { consoleAttr = NSMutableAttributedString() } else { problemsAttr = NSMutableAttributedString() }
        refreshVisible()
    }
    @objc func toggleConsole() {
        collapsed.toggle()
        let target: CGFloat = collapsed ? 27 : 170
        NSAnimationContext.runAnimationGroup({ ctx in
            ctx.duration = 0.22
            ctx.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
            consoleHeight.animator().constant = target
        })
        collapseBtn.setGlyph(collapsed ? "▴" : "▾")
    }

    // ---------- Files / status ----------

    func refreshStatus() {
        if let lp = linkedPath {
            status.stringValue = "Linked: \(lp)"
            linkValue.stringValue = (lp as NSString).abbreviatingWithTildeInPath
        } else {
            status.stringValue = "Not linked — click Link… or run: opex link"
            linkValue.stringValue = "none"
        }
        interpLabel.stringValue = luaPath != nil ? "Lua: ready" : "Lua: not found (brew install lua)"
    }

    func reloadFiles() {
        allFiles.removeAll()
        if let lp = linkedPath, let items = try? FM.contentsOfDirectory(atPath: lp) {
            allFiles = items
                .filter { ["lua", "txt", "rbxm", "rbxmx", "json"].contains(($0 as NSString).pathExtension) }
                .sorted { $0.localizedStandardCompare($1) == .orderedAscending }
        }
        filterFiles()
    }

    func filterFiles() {
        let q = searchField.stringValue
        files = q.isEmpty ? allFiles : allFiles.filter { $0.localizedCaseInsensitiveContains(q) }
        table.reloadData()
        if !files.isEmpty {
            table.selectRowIndexes(IndexSet(integer: 0), byExtendingSelection: false)
        } else {
            currentFile = nil
            editor.string = ""
            updateTabLabel()
        }
    }

    func loadSelected() {
        let row = table.selectedRow
        guard row >= 0, row < files.count, let lp = linkedPath else { currentFile = nil; updateTabLabel(); return }
        currentFile = files[row]
        let url = URL(fileURLWithPath: lp).appendingPathComponent(files[row])
        editor.string = (try? String(contentsOf: url, encoding: .utf8)) ?? ""
        LuaHighlight.apply(to: editor)
        gutter.refresh()
        updateTabLabel()
    }

    func updateTabLabel() {
        let dotColor = currentFile == nil ? Theme.dim : Theme.green
        let s = NSMutableAttributedString(string: "●  ", attributes: [
            .foregroundColor: dotColor, .font: NSFont.systemFont(ofSize: 11)
        ])
        s.append(NSAttributedString(string: currentFile ?? "No file", attributes: [
            .foregroundColor: Theme.text, .font: NSFont.systemFont(ofSize: 12, weight: .medium)
        ]))
        tabLabel.attributedStringValue = s
    }

    // ---------- Delegates ----------

    func controlTextDidChange(_ obj: Notification) { filterFiles() }

    func textDidChange(_ notification: Notification) {
        LuaHighlight.apply(to: editor)
        gutter.refresh()
    }

    func numberOfRows(in tableView: NSTableView) -> Int { files.count }

    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
        let id = NSUserInterfaceItemIdentifier("cell")
        let label: NSTextField
        if let v = table.makeView(withIdentifier: id, owner: nil) as? NSTextField {
            label = v
        } else {
            label = NSTextField(labelWithString: "")
            label.identifier = id
            label.lineBreakMode = .byTruncatingMiddle
            label.font = NSFont.systemFont(ofSize: 12)
        }
        label.textColor = Theme.text
        label.stringValue = files[row]
        return label
    }

    func tableViewSelectionDidChange(_ notification: Notification) { loadSelected() }
