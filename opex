final class PillButton: NSButton {
    private var baseColor: NSColor
    private var hoverColor: NSColor
    private var tracking: NSTrackingArea?

    init(title: String, base: NSColor, textColor: NSColor, target: AnyObject?, action: Selector, tooltip: String) {
        baseColor = base
        hoverColor = base.blended(withFraction: 0.20, of: .white) ?? base
        super.init(frame: .zero)
        isBordered = false
        setButtonType(.momentaryChange)
        wantsLayer = true
        attributedTitle = NSAttributedString(string: title, attributes: [
            .font: NSFont.systemFont(ofSize: 12.5, weight: .semibold),
            .foregroundColor: textColor
        ])
        self.target = target
        self.action = action
        toolTip = tooltip
    }
    required init?(coder: NSCoder) { fatalError("unsupported") }
    override func layout() {
        super.layout()
        wantsLayer = true
        layer?.cornerRadius = 6
        layer?.backgroundColor = baseColor.cgColor
    }
    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let t = tracking { removeTrackingArea(t) }
        let t = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeInKeyWindow], owner: self, userInfo: nil)
        addTrackingArea(t)
        tracking = t
    }
    override func mouseEntered(with event: NSEvent) { layer?.backgroundColor = hoverColor.cgColor }
    override func mouseExited(with event: NSEvent)  { layer?.backgroundColor = baseColor.cgColor }
    override var intrinsicContentSize: NSSize {
        let s = attributedTitle.size()
        return NSSize(width: s.width + 22, height: 26)
    }
}

final class TextButton: NSButton {
