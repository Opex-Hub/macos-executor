## CLI usage
opex                 # open the app
opex link            # pick your Roblox folder
opex reveal          # show linked folder in Finder
opex new script.lua  # create a script
opex list            # list scripts
opex status          # show link
opex unlink          # remove the link
README_EOF

# ----------------------------------------------------------
# Done — auto-launch (prompt only if running interactively)
# ----------------------------------------------------------
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║           ✔  Install Complete            ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════╝${NC}"
echo ""
echo -e "  ${CYAN}App:${NC}      $APP_PATH"
echo -e "  ${CYAN}CLI:${NC}      $BIN_DIR/opex"
echo ""

if [ -t 0 ]; then
    read -p "Launch Opex-MacOS now? [Y/n] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Nn]$ ]]; then
        open "$APP_PATH"
        echo -e "${GREEN}[✔] Opex-MacOS launched!${NC}"
    fi
else
    open "$APP_PATH"
    echo -e "${GREEN}[✔] Opex-MacOS launched!${NC}"
    echo -e "${YELLOW}Note: 'opex' command works in NEW terminal windows.${NC}"
fi
